# Copy this file to .env and adjust values as needed.

# Django
DEBUG=true
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# PostgreSQL (must match docker-compose.yml)
POSTGRES_DB=healthms
POSTGRES_USER=healthms
POSTGRES_PASSWORD=healthms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LIS connection settings used by the HMS integration client
LIS_API_BASE_URL=http://127.0.0.1:8000
LIS_SERVICE_USERNAME=hms_demo
LIS_SERVICE_PASSWORD=HmsDemo#2024
LIS_TIMEOUT_SECONDS=5

# Seed command
DEMO_LAB_ADMIN_PASSWORD=LabAdmin#2024
DEMO_HMS_PASSWORD=HmsDemo#2024
